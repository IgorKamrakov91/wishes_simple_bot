# Telegram bot credentials
# Create a bot with @BotFather and use the token only in your local .env.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-token

# Public bot username used when generating wishlist share links.
BOT_USERNAME=YourWishlistBot

# Rails runtime options
RAILS_MAX_THREADS=5
PORT=3000
RAILS_LOG_LEVEL=info
WEB_CONCURRENCY=2
SOLID_QUEUE_IN_PUMA=true

# Production deployment values (do not fill with real secrets here).
RAILS_MASTER_KEY=replace-with-your-rails-master-key
DATABASE_URL=postgres://user:password@localhost/wishes_simple_bot_production
WISHES_SIMPLE_BOT_DATABASE_PASSWORD=replace-with-production-password
