# Secrets for Kamal. This file is committed: never put raw values here.
# Values are read from the gitignored .env.production in the project root
# (keys: TELEGRAM_BOT_TOKEN, BOT_USERNAME, POSTGRES_PASSWORD, YANDEX_AI_API_KEY, YANDEX_AI_FOLDER_ID).

RAILS_MASTER_KEY=$(cat config/master.key)

TELEGRAM_BOT_TOKEN=$(grep '^TELEGRAM_BOT_TOKEN=' .env.production | cut -d= -f2-)
BOT_USERNAME=$(grep '^BOT_USERNAME=' .env.production | cut -d= -f2-)

# Optional: without them gift ideas stay hidden
YANDEX_AI_API_KEY=$(grep '^YANDEX_AI_API_KEY=' .env.production | cut -d= -f2-)
YANDEX_AI_FOLDER_ID=$(grep '^YANDEX_AI_FOLDER_ID=' .env.production | cut -d= -f2-)

# Must be URL-safe (e.g. `openssl rand -hex 24`): it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=$(grep '^POSTGRES_PASSWORD=' .env.production | cut -d= -f2-)
DATABASE_URL=postgres://wishes_simple_bot:${POSTGRES_PASSWORD}@db:5432/wishes_simple_bot
